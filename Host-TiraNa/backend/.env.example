FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-another-long-random-string

# Oracle connection (python-oracledb, thin mode — no Oracle Client install needed)
# Format: oracle+oracledb://USERNAME:PASSWORD@HOST:PORT/?service_name=SERVICENAME
DATABASE_URL=oracle+oracledb://USERNAME:PASSWORD@localhost:1521/?service_name=FREEPDB1

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Client backend API URL
CLIENT_API_URL=http://localhost:5000

# Admin-TiraNa API
ADMIN_API_URL=http://localhost:5002
ADMIN_INTERNAL_API_KEY=tirana-internal-secret-key
