# Client backend API URL — for revenue/reviews queries via HTTP (never direct DB)
# host.docker.internal lets the Flask container reach the client server
# running on the host machine at port 5000.
CLIENT_API_URL=http://host.docker.internal:5000

# Admin-TiraNa API — for withdrawal operations
ADMIN_API_URL=http://host.docker.internal:5002
