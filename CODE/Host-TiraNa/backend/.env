# Copy this to .env and fill in real values.
# .env should be in .gitignore — never commit real secrets.

FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-another-long-random-string

# Oracle connection (python-oracledb, thin mode — no Oracle Client install needed)
# Format: oracle+oracledb://USERNAME:PASSWORD@HOST:PORT/?service_name=SERVICENAME
